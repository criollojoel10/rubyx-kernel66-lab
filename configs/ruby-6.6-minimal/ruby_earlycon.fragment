# Ruby 6.6 early-console fragment
# Base: mediatek-bazel_defconfig + mt6877_overlay.config
# No es un defconfig completo: es un fragmento de overlay.

# Plataforma
CONFIG_ARCH_MEDIATEK=y

# Consola
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Almacenamiento
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_MEDIATEK=y

# PMIC / RTC / watchdog
CONFIG_MFD_MT6397=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_MEDIATEK_WATCHDOG=y

# IOMMU, clocks y pinctrl
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_V1=y
CONFIG_COMMON_CLK_MT6877=y
CONFIG_PINCTRL_MT6877=y

# Droidspaces: built-in desde el inicio
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_DEVICE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
