# Kernel de release de ruby: display + tactil + carga + Droidspaces.
#
# Los simbolos de Droidspaces (IPC_NS, PID_NS, SYSVIPC...) requieren el parche
# kABI oficial (scripts/apply-droidspaces-kabi.sh) aplicado al GKI.

# --- display ---
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MEDIATEK=n
CONFIG_DRM_PANEL_M16_36_02_0B_DSC_VDO=m

# --- tactil ---
CONFIG_TOUCHSCREEN_FOCALTECH_3680=m

# --- carga ---
# ruby carga por el cargador del PMIC auxiliar mt6360: mismo SoC que el A34,
# que ya lo trae (CONFIG_DEVICE_MODULES_CHARGER_MT6360=m en el config del
# build). Los chips externos del dtbo (mp2762, ln8000, xmusb350...) NO son los
# que usa el kernel stock de ruby, asi que sus ports quedan como referencia
# y no se compilan.

# --- TEE (Microtrust TEEI 400) ---
CONFIG_MICROTRUST_TEE_SUPPORT=m
CONFIG_MICROTRUST_TEE_VERSION="400"
CONFIG_MICROTRUST_TZ_DRIVER=y
CONFIG_MICROTRUST_VFS_DRIVER=y
CONFIG_MICROTRUST_FP_DRIVER=y
CONFIG_MICROTRUST_KEYMASTER_DRIVER=y
# El TEEI 400 llama a bootprof_log_boot() si CONFIG_MTPROF=m y el bootprof
# de MTK vive en los device modules (que no se compilan): se desactiva.
CONFIG_MICROTRUST_TZ_DRIVER_MTK_BOOTPROF=n


# --- Droidspaces (doc oficial: droidspaces.org/docs/kernel-configuration) ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
