# Kernel de producto de ruby.
#
# Display y tactil: el GKI del A34 (mismo SoC MT6877, mismo panel m16) ya
# trae portados a 6.6 el panel m16 36-02-0b y el tactil Focaltech FT3680.
# Se compilan built-in (=y), igual que en el kernel stock de ruby.
CONFIG_DRM_PANEL_M16_42_0D_0A_DSC_VDO=y
CONFIG_TOUCHSCREEN_FOCALTECH_3680=y

# Display: se usa la API mediatek_v2 (device modules) y se apaga la v1 del
# GKI para no duplicar simbolos (mtk_dsi_*, mtk_disp_*).
# El TEEI 400 llama a bootprof_log_boot() si CONFIG_MTPROF=m y el bootprof
# de MTK vive en los device modules (que no se compilan): se desactiva.
CONFIG_MICROTRUST_TZ_DRIVER_MTK_BOOTPROF=n
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MEDIATEK=n

# Carga: drivers de chip de ruby portados desde el 4.19 (modulos).
CONFIG_RUBY_MP2762=m
CONFIG_RUBY_LN8410=m
CONFIG_RUBY_BQ25980=m
CONFIG_RUBY_SC8561=m
CONFIG_RUBY_MAX77932=m
CONFIG_RUBY_XMUSB350=m
