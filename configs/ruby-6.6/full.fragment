# Kernel de producto de ruby (display + tactil + huella + TEE).
#
# En el kernel stock de ruby todos estos drivers van built-in (=y), asi que
# aqui tambien. Ver docs/104-gaps-vivos.md (inventario en vivo).
#
# Display: se usa la API mediatek_v2 (copiada al GKI desde los device
# modules) y se apaga la v1 del GKI para no duplicar simbolos
# (mtk_dsi_*, mtk_disp_*). El DTB de ruby ya usa los compatibles de la v2
# (mediatek,mt6877-disp-ovl), asi que no hay que tocarlo.
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MEDIATEK=n

# Panel m16 42-0d-0a (1080x2400, DSC VDO): el que declara el cmdline del
# kernel stock. Port en port/display (DCS y timings del 4.19 de ruby).
# los tres paneles m16 de ruby (el dtbo declara el 42-0d-0a y el 36-02-0b)
CONFIG_DRM_PANEL_M16_42_0D_0A_DSC_VDO=y
CONFIG_DRM_PANEL_M16_36_02_0B_DSC_VDO=y
CONFIG_DRM_PANEL_M16_45_02_0C_DSC_VDO=y

# Tactil Focaltech FT3680 por SPI3: port en port/touch.
CONFIG_TOUCHSCREEN_FOCALTECH_3680=y

# Huella Goodix por SPI (UUID de la TA Goodix 0x8888c03f): port en
# port/fingerprint (desde el 4.19 de ruby).
CONFIG_GOODIX_CAP_FINGERPRINT=y

# TEE: Microtrust TEEI 400 (el TEE real de ruby). El TEEI llama a
# bootprof_log_boot() si CONFIG_MTPROF=m, y ese simbolo vive en los device
# modules (que no se compilan): se desactiva el bootprof.
CONFIG_MICROTRUST_TZ_DRIVER_MTK_BOOTPROF=n

# Carga: no hay nada que portar. ruby carga con el cargador del PMIC
# mt6360, que el A34 ya trae (CONFIG_DEVICE_MODULES_CHARGER_MT6360).

# --- audio: card MT6877 + altavoz Awinic aw882xx ---
# El kernel que se arranca lo construye el arbol de device modules
# (mediatek-bazel_defconfig + este overlay), y el audio del stock va ahi como
# modulos: la common/ y la card solo se compilan si existe el simbolo
# DEVICE_MODULES_SND_SOC_MEDIATEK, y mtk-afe-external.ko (que exporta
# mtk_spk_*, notify_vb_audio_control y los notifier de 3way) solo si esta
# SMART_PHONE. Sin esos tres, mediatek-drm.ko, adsp-v0.ko, scp.ko,
# mtk-scp-vow.ko y snd-soc-tfa98xx.ko quedan con simbolos indefinidos.
CONFIG_DEVICE_MODULES_SND_SOC_MEDIATEK=m
CONFIG_DEVICE_MODULES_SND_SOC_MT6359P=m
CONFIG_SND_SOC_MTK_SMART_PHONE=m
CONFIG_SND_SOC_MTK_SRAM=m
CONFIG_SND_SOC_MT6877=m
CONFIG_SND_SOC_MT6877_MT6359P=m
CONFIG_DEVICE_MODULES_MFD_MT6397=m
# El altavoz (aw882xx) es un codec independiente: no usa simbolos de MTK, asi
# que se queda en el arbol del GKI y la card del arbol de device modules lo
# engancha por nombre desde su dai_link. Ojo: el port (28k lineas del 4.19)
# todavia NO se ha compilado nunca; se reactiva cuando pase un build.
# CONFIG_SND_SMARTPA_AW882XX=m

# El vibrador (aw8697) sigue pendiente: no compila todavia.
# CONFIG_INPUT_AW8697_HAPTIC=y
