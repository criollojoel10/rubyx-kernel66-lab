# Droidspaces core GKI — subconjunto sin riesgo de KMI.
# No incluye SYSVIPC, CGROUP_PIDS ni CFS_BANDWIDTH: esas opciones redimensionan
# task_struct/cgroup y cambian el CRC de miles de símbolos exportados.
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_MACVLAN=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
