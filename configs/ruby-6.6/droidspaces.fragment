# Ruby 6.6 — Droidspaces en el core GKI
# Nivel 1: sin riesgo de KMI.
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_MACVLAN=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_CHECKPOINT_RESTORE=y

# Nivel 2: requieren parche kABI y rebuild de módulos.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CFS_BANDWIDTH=y
