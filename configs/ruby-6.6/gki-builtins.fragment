# Built-ins de ruby que viven en el arbol del GKI (la Image).
#
# La Image del A34 se construye solo con el arbol kernel-6.6 y su
# gki_defconfig; lo que se escribe en el .config de los device modules no
# llega a la Image.
#
# De todo el stack de ruby, lo unico que tiene que ir DENTRO de la Image es
# el TEE: el TEEI esta enganchado como built-in en el arbol del GKI y su
# simbolo solo existe en los Kconfig de los device modules.
#
# El resto (mediatek_v2, paneles m16, tactil FT3680, huella Goodix) se queda
# como estaba en el A34: modulos del arbol de device modules o modulos de
# vendor que ya trae el dispositivo. Meterlos en la Image obliga a arrastrar
# medio arbol de vendor (mtk_disp_notify, mtk_panel_ext, prize, ...) y no
# aporta nada: el modo que arrancaba con pantalla y tactil no los tenia
# built-in.

# TEE Microtrust TEEI 400 (el TEE de ruby). El port copia los fuentes y el
# Kconfig al arbol del GKI, asi que aqui solo hay que encenderlo; la version
# 400 es la que existe en el arbol. El bootprof vive en los device modules
# (que no se compilan) y lo unico que hace es un log: se apaga.
# El TEEI vive dentro de `if TEE` en drivers/tee/Kconfig: sin el menuconfig
# TEE encendido sus simbolos ni se evaluan.
CONFIG_TEE=y
CONFIG_MICROTRUST_TEE_SUPPORT=y
CONFIG_MICROTRUST_TEE_VERSION="400"
CONFIG_MICROTRUST_TZ_DRIVER=y
CONFIG_MICROTRUST_TZ_DRIVER_MTK_BOOTPROF=n

# Namespaces requeridos por Android 15 (zygote) y DroidSpaces.
# El GKI del A34 los deja desactivados; sin PID_NS/IPC_NS zygote aborta
# (SIGABRT) y DroidSpaces no puede crear contenedores.
#
# v51 (2026-10-24): bisect de UNA variable. CGROUP_PIDS se elimina para
# probar si el controlador pids es lo que rompe a zygote cuando empieza a
# crear procesos. La linea se ELIMINA, no se comenta: patch-gki-core.sh
# ignora las lineas que empiezan por '#' y el simbolo quedaria como estaba.
# NAMESPACES/UTS_NS/IPC_NS/PID_NS/NET_NS/USER_NS no cambian.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
