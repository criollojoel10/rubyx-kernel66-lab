/dts-v1/;
/plugin/;

/ {
	model = "RUBY";
	compatible = "mediatek,MT6877";

	fragment@0 {
		target = <&odm>;

		__overlay__ {

			xiaomi_touch: xiaomi_touch {
				compatible = "xiaomi-touch";
				status = "ok";
				touch,name = "xiaomi-touch";
				phandle = <0x68>;
			};
		};
	};

	fragment@1 {
		target = <&mt6360_pmic>;

		__overlay__ {
			pwr-off-seq = <0x4000002>;
		};
	};

	fragment@2 {
		target = <&mt6360_typec>;

		__overlay__ {
			mt6360pd,intr_gpio_num = <0x05>;
			mt6360pd,intr_gpio = <&pio>, <0x05 0x00>;
			charger = <&mt6360_chg>;
		};
	};

	fragment@3 {
		target = <&pio>;

		__overlay__ {

			mtkfb_pins_lcm_led_en1: lcm_led_en1_gpio {
				phandle = <0x01>;

				pins_cmd_dat {
					pinmux = <0x6b00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_led_en0: lcm_led_en0_gpio {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x6b00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcd_bias_enp1: lcd_bias_enp1_gpio {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0x6c00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcd_bias_enp0: lcd_bias_enp0_gpio {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0x6c00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcd_bias_enn1: lcd_bias_enn1_gpio {
				phandle = <0x05>;

				pins_cmd_dat {
					pinmux = <0x6f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcd_bias_enn0: lcd_bias_enn0_gpio {
				phandle = <0x06>;

				pins_cmd_dat {
					pinmux = <0x6f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
				phandle = <0x07>;

				pins_cmd_dat {
					pinmux = <0x2800>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0x2800>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0x2701>;
				};
			};

			mtkfb_pins_lcm_err_flag: lcm_err_flag {
				phandle = <0x0a>;

				pins_cmd_dat {
					pinmux = <0x900>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};
		};
	};

	fragment@4 {
		target = <&mtkfb>;

		__overlay__ {
			pinctrl-names = "lcm_led_en1_gpio", "lcm_led_en0_gpio", "lcd_bias_enp1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enn1_gpio", "lcd_bias_enn0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "err_flag_init";
			pinctrl-0 = <&mtkfb_pins_lcm_led_en1>;
			pinctrl-1 = <&mtkfb_pins_lcm_led_en0>;
			pinctrl-2 = <&mtkfb_pins_lcd_bias_enp1>;
			pinctrl-3 = <&mtkfb_pins_lcd_bias_enp0>;
			pinctrl-4 = <&mtkfb_pins_lcd_bias_enn1>;
			pinctrl-5 = <&mtkfb_pins_lcd_bias_enn0>;
			pinctrl-6 = <&mtkfb_pins_lcm_rst_out1_gpio>;
			pinctrl-7 = <&mtkfb_pins_lcm_rst_out0_gpio>;
			pinctrl-8 = <&mtkfb_pins_lcm_dsi_te>;
			pinctrl-9 = <&mtkfb_pins_lcm_err_flag>;
			status = "okay";
		};
	};

	fragment@5 {
		target = <&dispsys_config>;

		__overlay__ {
			pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "err_flag_init";
			pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
			pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
			pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
			pinctrl-3 = <&mtkfb_pins_lcm_err_flag>;
			status = "okay";
		};
	};

	fragment@6 {
		target = <&odm>;

		__overlay__ {

			led0: led@0 {
				compatible = "mediatek,red";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x69>;
			};

			led1: led@1 {
				compatible = "mediatek,green";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x6a>;
			};

			led2: led@2 {
				compatible = "mediatek,blue";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x6b>;
			};

			led3: led@3 {
				compatible = "mediatek,jogball-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x6c>;
			};

			led4: led@4 {
				compatible = "mediatek,keyboard-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x6d>;
			};

			led5: led@5 {
				compatible = "mediatek,button-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x6e>;
			};

			led6: led@6 {
				compatible = "mediatek,lcd-backlight";
				led_mode = <0x04>;
				data = <0x01>;
				led_config = <0x0c 0x0c>;
				phandle = <0x6f>;
			};

			vibrator0: vibrator@0 {
				status = "disabled";
				compatible = "mediatek,vibrator";
				vib_timer = <0x19>;
				vib_limit = <0x09>;
				vib_vol = <0x09>;
				phandle = <0x70>;
			};
		};
	};

	fragment@7 {
		target = <&spi5>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			fingerprint@0 {
				compatible = "goodix,goodix-fp";
				reg = <0x00>;
				spi-max-frequency = <0x7a1200>;
				netlink-event = <0x1e>;
				vfp-supply = <&mt_pmic_vfp_ldo_reg>;
				power-type = <0x01>;
				status = "okay";
			};
		};
	};

	fragment@8 {
		target = <&mt_pmic_vfp_ldo_reg>;

		__overlay__ {
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
		};
	};

	fragment@9 {
		target = <&goodix_fp>;

		__overlay__ {
			pinctrl-names = "default", "reset_high", "reset_low", "eint_init", "spi_cs";
			pinctrl-0;
			pinctrl-1 = <&fingerprint_reset_high>;
			pinctrl-2 = <&fingerprint_reset_low>;
			pinctrl-3 = <&fingerprint_eint_init>;
			pinctrl-4 = <&fingerprint_spi_cs>;
			fpc,gpio_irq = <&pio>, <0x16 0x00>;
			interrupt-parent = <&pio>;
			interrupts = <0x16 0x01 0x16 0x00>;
			status = "okay";
		};
	};

	fragment@10 {
		target = <&pio>;

		__overlay__ {

			fingerprint_reset_high: state_reset_high {
				phandle = <0x0b>;

				pins_cmd_dat {
					pinmux = <0x1500>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			fingerprint_reset_low: state_reset_low {
				phandle = <0x0c>;

				pins_cmd_dat {
					pinmux = <0x1500>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			fingerprint_eint_init: state_eint_init {
				phandle = <0x0d>;

				pins_cmd_dat {
					pinmux = <0x1600>;
					slew-rate = <0x00>;
					bias-pull-up = <0x66>;
					input-schmitt-enable;
				};
			};

			fingerprint_spi_cs: state_spi_cs {
				phandle = <0x0e>;

				pins_cmd_dat {
					pinmux = <0x6301>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};
		};
	};

	fragment@11 {
		target = <&pio>;

		__overlay__ {

			gps_pins_default: gps_default {
				phandle = <0x0f>;
			};

			gps_l1_lna_pins_ol: gps_l1_lna@0 {
				phandle = <0x10>;

				pins_cmd_dat {
					pinmux = <0xbc00>;
					output-low;
				};
			};

			gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
				phandle = <0x11>;

				pins_cmd_dat {
					pinmux = <0xbc04>;
				};
			};

			gps_l1_lna_pins_oh: gps_l1_lna@2 {
				phandle = <0x12>;

				pins_cmd_dat {
					pinmux = <0xbc00>;
					output-high;
				};
			};

			gps_l5_lna_pins_ol: gps_l5_lna@0 {
				phandle = <0x13>;

				pins_cmd_dat {
					pinmux = <0xbd00>;
					output-low;
				};
			};

			gps_l5_lna_pins_dsp_ctrl: gps_l5_lna@1 {
				phandle = <0x14>;

				pins_cmd_dat {
					pinmux = <0xbd04>;
				};
			};

			gps_l5_lna_pins_oh: gps_l5_lna@2 {
				phandle = <0x15>;

				pins_cmd_dat {
					pinmux = <0xbd00>;
					output-high;
				};
			};
		};
	};

	fragment@12 {
		target = <&gps>;

		__overlay__ {
			pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable", "gps_l5_lna_disable", "gps_l5_lna_dsp_ctrl", "gps_l5_lna_enable";
			pinctrl-0 = <&gps_pins_default>;
			pinctrl-1 = <&gps_l1_lna_pins_ol>;
			pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
			pinctrl-3 = <&gps_l1_lna_pins_oh>;
			pinctrl-4 = <&gps_l5_lna_pins_ol>;
			pinctrl-5 = <&gps_l5_lna_pins_dsp_ctrl>;
			pinctrl-6 = <&gps_l5_lna_pins_oh>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <&accdet>;

		__overlay__ {
			mediatek,mic-vol = <0x08>;
			mediatek,pwm-deb-setting = <0x500 0x500 0x01 0x1f0 0x800 0x6000 0x20 0x44 0x04 0x01 0x05 0x03 0x03 0x05 0x0e>;
			mediatek,plugout-debounce = <0x01>;
			mediatek,mic-mode = <0x02>;
			mediatek,key-mode = <0x00>;
			mediatek,three-key-thr = <0x00 0x50 0xdc 0x190>;
			mediatek,tri-key-cdd-thr = <0x00 0x79 0xc0 0x258>;
			mediatek,four-key-thr = <0x00 0x3a 0x79 0xc0 0x190>;
			mediatek,eint-use-ext-res = <0x00>;
			status = "okay";
		};
	};

	fragment@14 {
		target = <&keypad>;

		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&kpd_pins_default>;
		};
	};

	fragment@15 {
		target = <&pio>;

		__overlay__ {

			kpd_pins_default: kpdgpiodefault {
				phandle = <0x16>;

				pins_cmd_dat {
					pinmux = <0x7401>;
					bias-pull-up = <0x66>;
					input-enable;
					input-schmitt-enable;
				};
			};
		};
	};

	fragment@16 {
		target = <&ps5169>;

		__overlay__ {
			pinctrl-names = "enable", "disable";
			pinctrl-0 = <&ps_enable>;
			pinctrl-1 = <&ps_disable>;
			status = "okay";
		};
	};

	fragment@17 {
		target = <&pio>;

		__overlay__ {

			ps_enable: ps_enable {
				phandle = <0x17>;

				pins_cmd_dat {
					pinmux = <0x7900>;
					output-high;
				};
			};

			ps_disable: ps_disable {
				phandle = <0x18>;

				pins_cmd_dat {
					pinmux = <0x7900>;
					output-low;
				};
			};
		};
	};

	fragment@18 {
		target = <&i2c3>;

		__overlay__ {

			st21nfc@08 {
				compatible = "mediatek,nfc";
				reg = <0x08>;
				gpio-irq = <0x0b>;
				gpio-irq-std = <&pio>, <0x0b 0x00>;
				interrupt-parent = <&pio>;
				interrupts = <0x0b 0x04 0x0b 0x00>;
				gpio-rst = <0x0a>;
				gpio-rst-std = <&pio>, <0x0a 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "default", "nfc_active", "nfc_suspend";
				pinctrl-0 = <&nfc_default>;
				pinctrl-1 = <&nfc_int_active>, <&nfc_enable_active>;
				pinctrl-2 = <&nfc_int_suspend>, <&nfc_enable_suspend>;
			};
		};
	};

	fragment@19 {
		target = <&pio>;

		__overlay__ {

			nfc_default: nfc_default {
				phandle = <0x19>;
			};

			nfc_int_active: nfc_int_active {
				phandle = <0x1a>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					slew-rate = <0x00>;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			nfc_int_suspend: nfc_int_suspend {
				phandle = <0x1c>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					slew-rate = <0x00>;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			nfc_enable_active: nfc_enable_active {
				phandle = <0x1b>;

				pins_cmd_dat {
					pinmux = <0xa00>;
					slew-rate = <0x01>;
					output-high;
					drive-strength = <0x02>;
					bias-pull-up = <0x67>;
				};
			};

			nfc_enable_suspend: nfc_enable_suspend {
				phandle = <0x1d>;

				pins_cmd_dat {
					pinmux = <0xa00>;
					slew-rate = <0x01>;
					drive-strength = <0x02>;
					bias-disable;
				};
			};
		};
	};

	fragment@20 {
		target = <&spi1>;

		__overlay__ {

			st54spi@0 {
				compatible = "st,st54spi";
				reg = <0x00>;
				spi-max-frequency = <0x4c4b40>;
				gpio-power_nreset = <0x08>;
				gpio-power_nreset-std = <&pio>, <0x08 0x00>;
				power_mode = "ST54H";
				pinctrl-names = "pinctrl_state_mode_idle", "pinctrl_state_mode_spi";
				pinctrl-0 = <&pinctrl_state_mode_idle>;
				pinctrl-1 = <&pinctrl_state_mode_spi>;
				status = "okay";
			};
		};
	};

	fragment@21 {
		target = <&pio>;

		__overlay__ {

			pinctrl_state_mode_idle: pinctrl_state_mode_idle {
				phandle = <0x1e>;

				pins_cmd0_dat {
					pinmux = <0xb700>;
					input-enable;
					bias-pull-down;
				};
			};

			pinctrl_state_mode_spi: pinctrl_state_mode_spi {
				phandle = <0x1f>;

				pins_cmd0_dat {
					pinmux = <0xb701>;
					bias-disable;
				};
			};
		};
	};

	fragment@22 {
		target = <&pio>;

		__overlay__ {

			ts_reset_active: ts_reset_active {
				phandle = <0x20>;

				pins_cmd_dat {
					pinmux = <0xf00>;
					bias-disable;
				};
			};

			ts_int_active: ts_int_active {
				phandle = <0x21>;

				pins_cmd_dat {
					pinmux = <0xe00>;
					bias-disable;
				};
			};

			ts_int_suspend: ts_int_suspend {
				phandle = <0x22>;

				pins_cmd_dat {
					pinmux = <0xe00>;
					slew-rate = <0x01>;
					bias-disable;
				};
			};

			ts_reset_suspend: ts_reset_suspend {
				phandle = <0x23>;

				pins_cmd_dat {
					pinmux = <0xf00>;
					slew-rate = <0x01>;
					bias-pull-down;
				};
			};

			ts_spi_mode: ts_spimode {
				phandle = <0x24>;

				pins_cmd_dat {
					pinmux = <0xa002 0xa102 0xa202 0xa302>;
					drive-strength = <0x02>;
				};
			};

			ts_dvdd_enable: ts_dvddenable {
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x6e00>;
					output-high;
				};
			};

			ts_dvdd_disable: ts_dvdddisable {
				phandle = <0x26>;

				pins_cmd_dat {
					pinmux = <0x6e00>;
					output-low;
				};
			};
		};
	};

	fragment@23 {
		target = <&mt_pmic_vmc_ldo_reg>;

		__overlay__ {
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
		};
	};

	fragment@24 {
		target = <&mt_pmic_vtp_ldo_reg>;

		__overlay__ {
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
		};
	};

	fragment@25 {
		target = <&spi3>;

		__overlay__ {
			mediatek,pad-select = <0x00>;
			mediatek,kthread-rt = <0x01>;
			status = "ok";

			m16-touch@0 {
				status = "ok";
				compatible = "focaltech,3680-spi", "goodix,9916r-spi";
				reg = <0x00>;
				panel-id-gpios = <&pio>, <0x26 0x00>, <&pio>, <0xa4 0x00>;
				interrupt-parent = <&pio>;
				interrupts = <0x0e 0x2008>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_spi_mode", "pmx_ts_dvdd_enable", "pmx_ts_dvdd_disable";
				pinctrl-0 = <&ts_reset_active>, <&ts_int_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				pinctrl-2 = <&ts_spi_mode>;
				pinctrl-3 = <&ts_dvdd_enable>;
				pinctrl-4 = <&ts_dvdd_disable>;
				iovdd-supply = <&mt_pmic_vmc_ldo_reg>;
				avdd-supply = <&mt_pmic_vtp_ldo_reg>;
				spi-max-frequency = <0x4c4b40>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,super-resolution-factors = <0x0a>;
				focaltech,display-coords = <0x00 0x00 0x2a30 0x5dc0>;
				focaltech,irq-gpio = <&pio>, <0x0e 0x2008>;
				focaltech,reset-gpio = <&pio>, <0x0f 0x00>;
				focaltech,avdd-name = "avdd";
				focaltech,iovdd-name = "iovdd";
				focaltech,touch-range-array = <0x01 0x05 0x0a 0x0f 0x14>;
				focaltech,touch-def-array = <0x04 0x03 0x03 0x03>;
				focaltech,touch-expert-array = <0x0a 0x0f 0x0a 0x0a 0x14 0x0f 0x0f 0x0a 0x0f 0x0f 0x14 0x0a>;
				goodix,avdd-name = "avdd";
				goodix,iovdd-name = "iovdd";
				goodix,reset-gpio = <&pio>, <0x0f 0x00>;
				goodix,irq-gpio = <&pio>, <0x0e 0x2808>;
				goodix,irq-flags = <0x02>;
				goodix,panel-max-x = <0x438>;
				goodix,panel-max-y = <0x960>;
				goodix,panel-max-w = <0xff>;
				goodix,panel-max-p = <0x1000>;
				goodix,iovdd-gpio = <&pio>, <0x6e 0x00>;
				goodix,firmware-namea = "goodix_firmware_m16_TM.bin";
				goodix,firmware-nameb = "goodix_firmware_m16_GVO.bin";
				goodix,config-namea = "goodix_cfg_group_m16_TM.bin";
				goodix,config-nameb = "goodix_cfg_group_m16_GVO.bin";
				goodix,touch-expert-array = <0x02 0x03 0x02 0x02 0x04 0x03 0x03 0x02 0x03 0x03 0x04 0x02>;
			};
		};
	};

	fragment@26 {
		target = <&sound>;

		__overlay__ {
			compatible = "mediatek,mt6877-mt6359-sound";
			mediatek,audio-codec = <&mt6359_snd>;
			mediatek,platform = <&afe>;
			mediatek,snd_audio_dsp = <&snd_audio_dsp>;
			mtk_spk_i2s_out = <0x03>;
			mtk_spk_i2s_in = <0x09>;

			mediatek,speaker-codec {
				sound-dai = <&aw882xx_smartpa_0>, <&aw882xx_smartpa_1>;
			};
		};
	};

	fragment@27 {
		target = <&i2c7>;

		__overlay__ {
			status = "okay";

			aw882xx_smartpa_0: aw882xx@34 {
				compatible = "awinic,aw882xx_smartpa";
				reg = <0x34>;
				irq-gpio = <&pio>, <0x79 0x00>;
				spk-sw-gpio = <&pio>, <0x6f 0x00>;
				sound-channel = <0x00>;
				aw-re-min = <0xfa0>;
				aw-re-max = <0x7530>;
				status = "okay";
				phandle = <0x27>;
			};

			aw882xx_smartpa_1: aw882xx@35 {
				compatible = "awinic,aw882xx_smartpa";
				reg = <0x35>;
				irq-gpio = <&pio>, <0x66 0x00>;
				sound-channel = <0x01>;
				aw-re-min = <0xfa0>;
				aw-re-max = <0x7530>;
				status = "okay";
				phandle = <0x28>;
			};
		};
	};

