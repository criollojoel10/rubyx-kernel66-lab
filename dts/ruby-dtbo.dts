				};

				fan53870_l6: on,fan53870@5 {
					offset = [00 05];
					regulator-name = "fan53870-l6";
					regulator-min-microvolt = <0x16f300>;
					regulator-max-microvolt = <0x33e140>;
					min-dropout-voltage = <0x493e0>;
