	fragment@47 {
		target = <&dsi0>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			panel1@0 {
				compatible = "m16_42_0d_0a_dsc_vdo,lcm";
				reg = <0x00>;
				pm-enable-gpios = <&pio>, <0x6b 0x00>;
				reset-gpios = <&pio>, <0x28 0x00>;
				vddi-gpios = <&pio>, <0x6c 0x00>;
				vibr30-supply = <&mt_pmic_vibr_ldo_reg>;
				vci-supply = <&mt_pmic_vibr_ldo_reg>;
				vdd-gpios = <&pio>, <0xa7 0x00>;
				mi,esd-err-irq-gpio = <&pio>, <0x09 0x2002>;

				port {

					panel_in1: endpoint {
						remote-endpoint = <&dsi_out>;
						phandle = <0x5d>;
					};
				};
			};

			panel2@0 {
				compatible = "m16_36_02_0b_dsc_vdo,lcm";
				reg = <0x01>;
				pm-enable-gpios = <&pio>, <0x6b 0x00>;
				reset-gpios = <&pio>, <0x28 0x00>;
				vddi-gpios = <&pio>, <0x6c 0x00>;
				vibr30-supply = <&mt_pmic_vibr_ldo_reg>;
				vci-supply = <&mt_pmic_vibr_ldo_reg>;
				vdd-gpios = <&pio>, <0xa7 0x00>;
				mi,esd-err-irq-gpio = <&pio>, <0x09 0x2002>;

				port {

					panel_in2: endpoint {
						remote-endpoint = <&dsi_out>;
						phandle = <0x78>;
					};
				};
			};

			panel3@0 {
				compatible = "m16_45_02_0c_dsc_vdo,lcm";
				reg = <0x02>;
				pm-enable-gpios = <&pio>, <0x6b 0x00>;
				reset-gpios = <&pio>, <0x28 0x00>;
				vddi-gpios = <&pio>, <0x6c 0x00>;
				vibr30-supply = <&mt_pmic_vibr_ldo_reg>;
				vci-supply = <&mt_pmic_vibr_ldo_reg>;
				vdd-gpios = <&pio>, <0xa7 0x00>;
				mi,esd-err-irq-gpio = <&pio>, <0x09 0x2002>;

				port {

					panel_in3: endpoint {
						remote-endpoint = <&dsi_out>;
						phandle = <0x79>;
					};
				};
			};

			ports {

				port {

					dsi_out: endpoint {
						remote-endpoint = <&panel_in1>;
						phandle = <0x5c>;
					};
				};
			};
		};
	};

