	fragment@29 {
		target = <&pio>;

		__overlay__ {

			awinic_reset_low: awinic_reset_low {
				phandle = <0x29>;

				pins_cmd_dat {
					pinmux = <0x8b00>;
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			awinic_reset_high: awinic_reset_high {
				phandle = <0x2a>;

				pins_cmd_dat {
					pinmux = <0x8b00>;
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
					output-high;
				};
			};

			awinic_interrupt: awinic_interrupt_high {
				phandle = <0x2b>;

				pins_cmd_dat {
					pinmux = <0x7500>;
					drive-strength = <0x02>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};
		};
	};

